# APP Config
PROJECT_NAME="NEXRA Messaging Platform"
VERSION="1.0.0"
API_STR="/api/v1"
SECRET_KEY="replace-with-a-very-secure-secret-key"

# Database
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nexra_db
SQLALCHEMY_DATABASE_URI="postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}/${POSTGRES_DB}"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# SMPP - MTN Ghana (Simulated/Dev)
MTN_SMPP_HOST=127.0.0.1
MTN_SMPP_PORT=2775
MTN_SMPP_SYSTEM_ID=nexra_mtn
MTN_SMPP_PASSWORD=mtn_pass
MTN_SMPP_SYSTEM_TYPE=VMA

# SMPP - Vodafone Ghana (Simulated/Dev)
VOD_SMPP_HOST=127.0.0.1
VOD_SMPP_PORT=2776
VOD_SMPP_SYSTEM_ID=nexra_vod
VOD_SMPP_PASSWORD=vod_pass
VOD_SMPP_SYSTEM_TYPE=VMA

# SMPP - AirtelTigo Ghana (Simulated/Dev)
ATG_SMPP_HOST=127.0.0.1
ATG_SMPP_PORT=2777
ATG_SMPP_SYSTEM_ID=nexra_atg
ATG_SMPP_PASSWORD=atg_pass
ATG_SMPP_SYSTEM_TYPE=VMA
